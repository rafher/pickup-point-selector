# Rellenado automáticamente por `shopify app dev` / `shopify app config link`.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=
SHOPIFY_APP_URL=

# Base de datos de la app (sesiones + configuración por tienda), en
# Postgres (Neon u otro proveedor). DATABASE_URL es la conexión agrupada
# (pooler) que usa la app en marcha; DIRECT_DATABASE_URL es la conexión
# directa (sin "-pooler" en el host) que usa `prisma migrate` al
# desplegar. En Neon, ambas están en la misma pantalla de "Connection
# string" (con/sin la opción "pooled connection").
DATABASE_URL=
DIRECT_DATABASE_URL=

# --- Servicio web de puntos de recogida ---------------------------------
# Mientras la agencia de transporte no tenga listo su servicio real, deja
# estas dos variables vacías: la app servirá automáticamente un listado de
# puntos de recogida de DEMOSTRACIÓN (datos fijos definidos en
# app/services/pickupPoints.mock.ts) para poder probar todo el flujo.
#
# En cuanto tengas la URL real, ponla aquí (o configúrala desde el panel
# de ajustes de la app en el Admin de Shopify, que tiene prioridad sobre
# estas variables y permite un valor distinto por cada tienda instalada).
PICKUP_POINTS_API_URL=
PICKUP_POINTS_API_KEY=

# --- Extensión de checkout (solo Shopify Plus) -----------------------------
# API key de Google Maps, compartida por Datadec para todas las tiendas que
# instalen la app (la extensión de checkout no puede usar Leaflet/OSM, el
# sandbox de checkout no permite scripts de terceros — solo el componente
# nativo <s-map>, que exige Google Maps). Restringir en Google Cloud Console
# a los dominios: https://*.myshopify.com, https://shop.app, https://shopify.com
GOOGLE_MAPS_API_KEY=
