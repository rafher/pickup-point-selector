# Rellenado automáticamente por `shopify app dev` / `shopify app config link`.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=
SHOPIFY_APP_URL=

# Base de datos de la app (sesiones + configuración por tienda). En
# producción, cadena de conexión de Postgres (p.ej. de Neon o de la que
# te dé tu hosting), tipo:
# DATABASE_URL="postgresql://usuario:contraseña@host/basededatos?sslmode=require"
DATABASE_URL=

# --- Servicio web de puntos de recogida ---------------------------------
# Mientras la agencia de transporte no tenga listo su servicio real, deja
# estas dos variables vacías: la app servirá automáticamente un listado de
# puntos de recogida de DEMOSTRACIÓN (datos fijos definidos en
# app/services/pickupPoints.mock.ts) para poder probar todo el flujo.
#
# En cuanto tengas la URL real, ponla aquí (o configúrala desde el panel
# de ajustes de la app en el Admin de Shopify, que tiene prioridad sobre
# estas variables y permite un valor distinto por cada tienda instalada).
PICKUP_POINTS_API_URL=
PICKUP_POINTS_API_KEY=
